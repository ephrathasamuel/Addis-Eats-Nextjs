# Addis Eats Environment Configuration Example
# Copy to .env.local for local development. NEVER commit .env*.local to git!

# Server-only secrets (Never prefix with NEXT_PUBLIC)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/addiseats"
SESSION_SECRET="addis-eats-super-secret-session-key-at-least-32-chars"
TELEBIRR_API_KEY="test_telebirr_mock_secret_key"

# Client-facing variables (Inlined into JS bundle at build time)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_VERSION="v1"
